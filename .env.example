# --- Database ---
# Leave DATABASE_URL unset to fall back to local SQLite (backend/production_rescue.db)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/production_rescue

# --- Google Gemini (Vertex AI / Google Gen AI SDK) ---
# If unset, the app runs in mock/deterministic mode for disruption parsing & explanations.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# Optional: set to true to route through Vertex AI instead of the Gemini Developer API
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# --- Partner integration: Parallel (parallel.ai) research/search API ---
# If unset, partner_service falls back to mock weather/context data.
PARALLEL_API_KEY=
PARALLEL_API_BASE=https://api.parallel.ai

# --- App ---
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_PER_MINUTE=60

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_DEMO_MODE=true
